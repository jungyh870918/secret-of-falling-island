; Engine configuration file.
; 떡락섬의 비밀 / 코드명 RED_CANDLE
; 명세서 §4.1, §21 기준. Godot 4.2+ 에서 열린다.

config_version=5

[application]

config/name="떡락섬의 비밀"
config/description="DOS풍 2D 포인트 앤 클릭 어드벤처. 코드명 RED_CANDLE. Phase 1 플레이어블 프로토타입."
config/version="0.1.0-proto"
run/main_scene="res://scenes/core/Main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Theming="*res://scripts/core/Theming.gd"
GameData="*res://scripts/core/GameData.gd"
Loc="*res://scripts/core/Localization.gd"
GameState="*res://scripts/core/GameState.gd"
SaveManager="*res://scripts/save/SaveManager.gd"
AudioDirector="*res://scripts/core/AudioDirector.gd"
SceneDirector="*res://scripts/core/SceneDirector.gd"

[display]

; 명세서 §6.2 내부 기준 해상도 320x180
window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
; §21 pixel-perfect / integer scaling
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[gui]

; §6.1 안티앨리어싱 금지
theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; §21 nearest texture filtering
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_2d=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[audio]

buses/default_bus_layout=""
